# Serverda shu faylni `.env` nomi bilan saqlang (GitHub'ga yuklamang!).
# Parollarda faqat harf va raqam ishlating (maxsus belgilar baza manzilini buzadi).

# Sayt manzili (domen) va to'liq URL
DOMAIN=kibersaboq.example.uz
APP_URL=https://kibersaboq.example.uz

# Baza paroli (uzun, tasodifiy)
POSTGRES_PASSWORD=ALMASHTIRING

# Sessiya kaliti: `openssl rand -base64 32` bilan yarating. Ikkalasi bir xil bo'lsin.
AUTH_SECRET=ALMASHTIRING
NEXTAUTH_SECRET=ALMASHTIRING

# Auth sozlamalari (APP_URL bilan bir xil)
AUTH_URL=https://kibersaboq.example.uz
NEXTAUTH_URL=https://kibersaboq.example.uz
AUTH_TRUST_HOST=true

# Parol tiklash xatlari uchun pochta (Gmail uchun "App password")
EMAIL_USER=
EMAIL_PASSWORD=

# Faqat birinchi admin yaratilayotganda kerak (keyin o'chirib tashlang)
ADMIN_EMAIL=
ADMIN_PASSWORD=
