diff --git a/lib/sanitize-html.ts b/lib/sanitize-html.ts
new file mode 100644
index 0000000..5474e7a
--- /dev/null
+++ b/lib/sanitize-html.ts
@@ -0,0 +1,32 @@
+import sanitizeHtml from "sanitize-html"
+
+// Tiptap muharriri chiqaradigan teglar. Script, iframe, onclick va shunga
+// o'xshash narsalar o'chiriladi (stored XSS dan himoya).
+const options: sanitizeHtml.IOptions = {
+  allowedTags: [
+    "p", "br", "hr", "h1", "h2", "h3", "h4", "h5", "h6",
+    "strong", "b", "em", "i", "u", "s", "code", "pre", "blockquote",
+    "ul", "ol", "li", "a", "img", "span", "div",
+  ],
+  allowedAttributes: {
+    a: ["href", "target", "rel"],
+    img: ["src", "alt", "title", "width", "height"],
+    "*": ["style"],
+  },
+  // Faqat matn tekislash (text-align) uslubiga ruxsat
+  allowedStyles: {
+    "*": { "text-align": [/^(left|right|center|justify)$/] },
+  },
+  allowedSchemes: ["http", "https", "mailto"],
+  allowedSchemesByTag: { img: ["http", "https"] },
+  transformTags: {
+    a: (tagName, attribs) => ({
+      tagName,
+      attribs: { ...attribs, rel: "noopener noreferrer nofollow", target: "_blank" },
+    }),
+  },
+}
+
+export function cleanLessonHtml(html: unknown): string {
+  return typeof html === "string" ? sanitizeHtml(html, options) : ""
+}
